{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/CONVENTIONS.md"],
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "ask",
      "git clean -f*": "ask",
      "git branch -D*": "ask",
      "rm -rf*": "ask",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "sudo*": "deny",
      "curl*|*sh": "deny",
      "wget*|*sh": "deny"
    }
  }
}
